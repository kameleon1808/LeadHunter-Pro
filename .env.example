# LeadHunter Pro — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (default: leadhunter.db in project root)
DATABASE_PATH=leadhunter.db

# ── AI Engine ─────────────────────────────────────────────────────────────────
# Primary engine: Claude Code CLI (claude -p)
#   Requires: Claude Pro subscription with Claude Code enabled
#   No API key needed — uses your existing plan
#
# Optional fallback: Anthropic API (direct, billed separately)
#   Uncomment and set your key to use the API instead of the CLI
# ANTHROPIC_API_KEY=sk-ant-...

# Claude model used by both engines
CLAUDE_MODEL=claude-sonnet-4-5

# ── Scraping ──────────────────────────────────────────────────────────────────
# Number of Google result pages to scrape per query (default: 5)
SEARCH_PAGES_DEFAULT=5

# Whether to run the Playwright browser in headless mode (true/false)
PLAYWRIGHT_HEADLESS=true

# ── Enrichment ────────────────────────────────────────────────────────────────
# Max concurrent HTTP requests when fetching company pages
ENRICHMENT_CONCURRENT_REQUESTS=5

# Max concurrent Claude Code CLI subprocesses (each has ~12s startup overhead)
CLAUDE_CODE_MAX_CONCURRENT=3

# Max pages to visit per company website
MAX_PAGES_PER_SITE=5

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# ── Export ────────────────────────────────────────────────────────────────────
# Default directory for Excel exports
# EXPORT_DIR=./exports/

# ── Brave Browser (Windows) ───────────────────────────────────────────────────
# Use your existing Brave profile (cookies, history) to reduce Google CAPTCHAs.
# Brave MUST be fully closed before running the scraper.
USE_BRAVE=true
BRAVE_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
BRAVE_USER_DATA_DIR=C:\Users\TVOJE_IME\AppData\Local\BraveSoftware\Brave-Browser\User Data

# ── Logging ───────────────────────────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (leave blank to log to console only)
# LOG_FILE=leadhunter.log
